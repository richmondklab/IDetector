# Exemple de variables d'environnement pour le backend iDetector.
# Copiez dans .env puis renseignez les valeurs réelles.
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_JSON_MODE=json_object
LLM_SEED=42
LLM_TIMEOUT_MS=30000
PORT=3000
NODE_ENV=development
TRUST_PROXY=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_IMAGE_MB=8
RATE_LIMIT_PER_MINUTE=20
DB_PATH=./data/idetector.db
ADMIN_PASSWORD=change_me_please
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace_with_a_strong_secret_value_here
ADMIN_SESSION_HOURS=8
